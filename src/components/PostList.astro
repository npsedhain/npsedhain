---
import { formatDate, type PostEntry } from '../lib/posts';

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

<ul class="dim-list -mx-3">
  {
    posts.map((post) => (
      <li>
        <a href={post.url} class="group flex items-baseline gap-4 rounded-lg px-3 py-2.5 transition-colors hover:bg-[var(--spot)]">
          <span class="flex-1">
            <span class="group-hover:text-accent transition-colors" transition:name={`title-${post.slug}`}>
              {post.title}
            </span>
          </span>
          <time datetime={post.date} class="shrink-0 font-mono text-xs tabular-nums text-muted">
            {formatDate(post.date, 'short')}
          </time>
        </a>
      </li>
    ))
  }
</ul>
