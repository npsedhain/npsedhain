<button
  type="button"
  data-theme-toggle
  aria-label="Toggle dark mode"
  class="group grid size-7 place-items-center rounded-full text-muted transition-colors hover:text-accent"
>
  <svg viewBox="0 0 24 24" class="size-4 transition-transform duration-500 group-active:rotate-90" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" class="fill-current dark:fill-none"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" class="dark:opacity-0 transition-opacity"></path>
  </svg>
</button>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
  });
</script>
