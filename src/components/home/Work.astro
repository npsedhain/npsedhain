---
import Section from '../Section.astro';
import { projects } from '../../data/projects';
---

<Section title="Selected work">
  <ul class="dim-list space-y-1">
    {
      projects.map((p) => (
        <li class="py-2.5">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="font-medium">
              {p.href ? (
                <a href={p.href} class="link" target="_blank" rel="noopener">
                  {p.name}
                </a>
              ) : (
                p.name
              )}
            </h3>
            <span class="shrink-0 font-mono text-xs text-muted">
              {p.href ? `${p.linkLabel ?? 'link'} ↗` : 'internal'}
            </span>
          </div>
          <p class="mt-1 text-sm leading-relaxed text-muted">{p.blurb}</p>
          <ul class="mt-1.5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px] text-muted" aria-label="Tools">
            {p.tags.map((t) => <li>{t}</li>)}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>
