---
// Numbers here must come straight from the resume. `countup` animates from 0 to that value;
// `width` reserves room (in ch) so the counting digits don't shift the layout.
interface Stat {
  value: string;
  countup?: number;
  width: number;
  label: string;
}

const stats: Stat[] = [
  { value: '80%', countup: 80, width: 4, label: 'less QA time once MCP agents took over regression tests' },
  { value: '4→2', width: 4, label: 'weeks from feature to release with an agentic pipeline' },
  { value: '2M+', countup: 2, width: 4, label: 'social posts analyzed to track how behavior shifts over time' },
  { value: '7', countup: 7, width: 4, label: 'years building products' },
];
---

<section class="mt-12 border-y border-line py-6" data-reveal aria-label="A few numbers">
  <dl class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
    {
      stats.map((s) => (
        <div class="flex flex-col-reverse justify-end">
          <dt class="mt-1 text-xs leading-snug text-muted">{s.label}</dt>
          <dd
            class="inline-block font-mono text-2xl font-medium tabular-nums tracking-tight"
            style={`min-width: ${s.width}ch`}
            data-countup={s.countup}
          >
            {s.value}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
