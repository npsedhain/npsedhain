---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/resume.pdf' && path.startsWith(href);
---

<header class="flex items-center justify-between py-8 text-sm">
  <a href="/" class="font-medium tracking-tight hover:text-accent transition-colors">
    {site.name}
  </a>
  <nav class="flex items-center gap-5">
    {
      site.nav.map((item) => (
        <a
          href={item.href}
          class:list={['link', isActive(item.href) ? 'text-accent' : 'text-muted']}
          data-astro-prefetch={item.href.endsWith('.pdf') ? 'false' : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>
