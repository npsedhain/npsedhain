---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page doesn't exist.">
  <div class="mt-16" data-stagger>
    <p class="font-mono text-xs uppercase tracking-widest text-muted">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">Nothing here.</h1>
    <p class="mt-4 text-muted">
      The page you were looking for doesn't exist, or it moved. Try the
      <a href="/" class="link text-[var(--fg)]">home page</a> or my
      <a href="/writing" class="link text-[var(--fg)]">writing</a>.
    </p>
  </div>
</Base>
