---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PostList from '../components/PostList.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import Experience from '../components/home/Experience.astro';
import Work from '../components/home/Work.astro';
import { getPosts } from '../lib/posts';

const posts = getPosts().slice(0, 5);
---

<Base>
  <Hero />
  <ProofStrip />
  <Experience />
  <Work />

  <Section title="Writing" href={posts.length ? '/writing' : undefined}>
    {
      posts.length ? (
        <PostList posts={posts} />
      ) : (
        <p class="text-sm text-muted">
          Writing is coming soon. Subscribe via <a href="/rss.xml" class="link">RSS</a>.
        </p>
      )
    }
  </Section>
</Base>
